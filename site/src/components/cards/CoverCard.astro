---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  href?: string
  cover?: ImageMetadata
}
const { href, cover } = Astro.props
const Tag = href ? 'a' : 'div'
---

<Tag class="gb-card" href={href}>
  {cover && <Image class="gb-card-cover" src={cover} alt="" width={720} densities={[1, 2]} />}
  <div class="gb-card-body"><slot /></div>
</Tag>
